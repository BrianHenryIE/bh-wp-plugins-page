{
  "config": {
    "WP_DEBUG_LOG": "/var/www/html/wp-content/debug.log"
  },
  "env": {
    "development": {
      "plugins": [
        "."
      ]
    },
    "tests": {
      "mysqlPort": 33066
    }
  },
  "lifecycleScripts": {
    "afterStart": "bash 'tests/_wp-env/initialize-external.sh'"
  },
  "mappings": {
    "../setup": "./tests/_wp-env",
    "wp-content/plugins/bh-wp-autologin-urls": "./wp-content/plugins/bh-wp-autologin-urls",
    "wp-content/plugins/jetpack": "./wp-content/plugins/jetpack",
    "wp-content/plugins/kb-support": "./wp-content/plugins/kb-support",
    "wp-content/plugins/lh-add-media-from-url": "./wp-content/plugins/lh-add-media-from-url",
    "wp-content/plugins/log-http-requests": "./wp-content/plugins/log-http-requests",
    "wp-content/plugins/query-monitor": "./wp-content/plugins/query-monitor",
    "wp-content/plugins/user-switching": "./wp-content/plugins/user-switching",
    "wp-content/plugins/webappick-product-feed-for-woocommerce": "./wp-content/plugins/webappick-product-feed-for-woocommerce",
    "wp-content/plugins/zippy": "./wp-content/plugins/zippy"
  },
  "phpVersion": "8.4"
}
